{
  "hosting": {
    
    "public": "apps/web/build/jaspr",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "preview-version.txt"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
    ]
  }
}
